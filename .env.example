# Variáveis de Conexão com o Supabase (Navegador e Servidor SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Variáveis Administrativas do Supabase (Apenas Servidor e Scripts de Agentes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token da Apify (para enriquecimento de CNPJ/Scraping)
APIFY_TOKEN=your_apify_token_here

# Credenciais de Envio de E-mail via Gmail (Nodemailer SMTP)
GMAIL_USER=seu-email@dominio.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
