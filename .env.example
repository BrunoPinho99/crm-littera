# Variáveis de Conexão com o Supabase (Navegador e Servidor SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Variáveis Administrativas do Supabase (Apenas Servidor e Scripts de Agentes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token da Apify (para busca de CNPJ/Scraping)
APIFY_TOKEN=your_apify_token_here

# Infraestrutura de Envio e Entregabilidade (Brevo API + Descadastro)
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here
UNSUBSCRIBE_SECRET=your_32_bytes_random_secret_for_hmac_sha256
APP_URL=https://littera.app.br
LITTERA_RAZAO_SOCIAL="Littera Educação e Tecnologia LTDA"
LITTERA_ENDERECO="Brasília - DF, Brasil"

# Google Places API (New) para descoberta de websites escolares
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Anthropic Claude SDK (para extração estruturada de decisores)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Hunter.io (Opcional - Domain Search e Email Finder)
HUNTER_API_KEY=your_hunter_api_key_here

# Identificação do Crawler (User-Agent em conformidade)
LITTERA_CONTATO=contato@littera.com.br

# Preços unitários estimados de serviços para tabela custos_agente (em USD)
PRICE_INPUT_PER_M=0.80
PRICE_OUTPUT_PER_M=4.00
PRICE_HUNTER_CREDIT_USD=0.019
PRICE_PLACES_SEARCH_USD=0.032

# Provedor de Verificação de E-mails (ZeroBounce, MillionVerifier ou NeverBounce)
EMAIL_VERIFIER=zerobounce
EMAIL_VERIFIER_API_KEY=your_email_verifier_api_key_here

# Disparo Remoto do GitHub Actions via Server Action
GITHUB_DISPATCH_TOKEN=ghp_your_fine_grained_token_with_actions_write
GITHUB_REPO=BrunoPinho99/crm-littera

# Parâmetros Operacionais do Agente SDR Diário
META_DIARIA=20
MAX_CUSTO_DIARIO_USD=5



# Chave Secreta para Endpoint do Cron de Sequências (/api/cron/sequencias)
CRON_SECRET=your_super_secret_cron_token_here

# E-mail de Notificação de Respostas Recebidas de Leads
NOTIFICAR_EMAIL=bruno@grupolittera.com.br

# Credenciais Google OAuth para Leitura de Respostas via Gmail API
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
TOKEN_ENCRYPTION_KEY=your_base64_32_bytes_aes_key

# Agendamento Automático de Reuniões (Opção A - Cal.com / Opção B - Google Agenda)
CALCOM_EVENT_URL=https://cal.com/littera/conversa-30min
CALCOM_WEBHOOK_SECRET=your_calcom_webhook_secret_here
GOOGLE_AGENDA_URL=https://calendar.google.com/calendar/u/0/r/appointment
